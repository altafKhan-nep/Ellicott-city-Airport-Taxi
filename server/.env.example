PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ridetaxi
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REMEMBER_ME_EXPIRY=30d
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Production hardening
TRUST_PROXY=false            # true when behind nginx/Render/Vercel (correct client IP)
RATE_LIMIT_API=600           # requests / 15 min per IP (global API)
RATE_LIMIT_AUTH=60           # requests / 15 min per IP (auth endpoints)
RATE_LIMIT_LOGIN=10          # login attempts / 15 min per IP

# Email (SMTP) - optional. If unset, emails are logged to the console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Social login - Passport OAuth2 redirect flow. Omit to disable the strategy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=         # default: {CLIENT_ORIGIN}/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=       # default: {CLIENT_ORIGIN}/api/auth/facebook/callback
